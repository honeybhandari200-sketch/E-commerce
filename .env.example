# Copy to .env.local and set a long random value (e.g. `openssl rand -hex 32`)
JWT_SECRET=change-me

# Stripe TEST keys from https://dashboard.stripe.com/test/apikeys
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Comma-separated emails of accounts that can open /admin
ADMIN_EMAILS=you@example.com

# Postgres connection string. `npm run db:setup` creates the database if it doesn't exist.
DATABASE_URL=postgres://localhost:5432/jsec_sofas
